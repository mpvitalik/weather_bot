# Telegram Bot Token from @BotFather in Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# OpenWeatherMap API Key (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE

# Check interval in seconds (default: 300 = 5 minutes)
CHECK_INTERVAL_SECONDS=300

# Default advance notification time before rain in minutes (15, 30, 45 or 60)
DEFAULT_ADVANCE_MINUTES=30

# Cooldown between rain alerts for the same user in minutes (default: 180 = 3 hours)
ALERT_COOLDOWN_MINUTES=180
